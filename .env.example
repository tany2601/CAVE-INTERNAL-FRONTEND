# Base URL of the CAVE backend API (including the /api prefix).
# Leave as /api in development: Vite proxies it to VITE_PROXY_TARGET, so no CORS setup is needed.
# For production builds point it at the deployed backend, e.g. https://api-cave.paperlighttech.com/api
# (deploy/deploy.sh sets this for you at build time)
VITE_API_BASE_URL=/api

# Dev-server proxy target for /api (only used by `pnpm dev` / `pnpm preview`).
VITE_PROXY_TARGET=http://localhost:3000
